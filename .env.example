# =============================================================================
# Variáveis de ambiente do LIMS — copie pra `.env` (gitignored) e ajuste valores
# =============================================================================
#
# Setup local:
#   1. cp .env.example .env
#   2. Substitua TODOS os "CHANGE_ME" abaixo por valores reais
#   3. docker-compose up -d
#
# Em produção, NÃO use .env — cadastre essas variáveis no sistema de secrets
# da sua plataforma (Fly.io: `fly secrets set`, Railway/Render: dashboard, etc.)

# -----------------------------------------------------------------------------
# Postgres — usuário/senha do banco. Mesmos valores em duas variáveis porque o
# Postgres usa pra criar o user, e a API usa na connection string.
# -----------------------------------------------------------------------------
POSTGRES_USER=lims_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=lims_db

# -----------------------------------------------------------------------------
# JWT — chave de assinatura HMAC-SHA256. **PRECISA ter no mínimo 32 chars.**
# Gere uma aleatória, por exemplo:
#   openssl rand -base64 48
#   (ou em PowerShell: [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256})))
#
# Trocar essa chave invalida TODOS os tokens existentes (usuários precisam
# logar de novo). Em prod, só troque se a chave foi comprometida.
# -----------------------------------------------------------------------------
JWT_KEY=CHANGE_ME_RANDOM_STRING_OF_AT_LEAST_32_CHARS
JWT_ISSUER=LimsProject
JWT_AUDIENCE=LimsProject

# -----------------------------------------------------------------------------
# RabbitMQ — credenciais do broker. Em dev, guest/guest é fine.
# Em prod, use senha forte (rabbitmq:3-management exige reset do guest pra
# conexões não-localhost — configure usuário próprio via env vars do image).
# -----------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# -----------------------------------------------------------------------------
# Ambiente — Development habilita Swagger UI, debug endpoints, etc.
# Em prod, mude pra "Production".
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
